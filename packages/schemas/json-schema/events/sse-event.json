  "description": "One message on the live event stream.",
  "$defs": {
    "Envelope": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 30,
          "maxLength": 30,
          "pattern": "^env_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "description": "A envelope id: \"env_\" followed by a ULID."
        },
        "orgId": {
          "type": "string",
