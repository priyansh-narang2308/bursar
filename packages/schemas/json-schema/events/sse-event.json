          "description": "A mandate id: \"mnd_\" followed by a ULID."
        },
        "status": {
          "type": "string",
          "enum": [
            "PENDING",
            "ACTIVE",
            "CLOSED",
            "VOIDED",
            "EXPIRED"
          ]
        },
        "ceiling": {
          "$ref": "#/$defs/Amount"
        },
        "held": {
          "$ref": "#/$defs/Amount"
        },
        "captured": {
          "$ref": "#/$defs/Amount"
        },
        "refunded": {
          "$ref": "#/$defs/Amount"
        },
        "settled": {
          "$ref": "#/$defs/Amount"
        },
        "authorizationExpiresAt": {
          "anyOf": [
            {
              "type": "string",
