          "maxLength": 30,
          "pattern": "^evt_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "description": "A event id: \"evt_\" followed by a ULID."
        },
        "orgId": {
          "type": "string",
          "minLength": 30,
          "maxLength": 30,
          "pattern": "^org_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "description": "A organization id: \"org_\" followed by a ULID."
        },
        "occurredAt": {
          "type": "string",
          "maxLength": 35,
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$",
          "description": "An instant in UTC, as RFC 3339 with a trailing Z."
        },
        "type": {
          "type": "string",
          "const": "action.state_changed"
        },
        "data": {
          "type": "object",
