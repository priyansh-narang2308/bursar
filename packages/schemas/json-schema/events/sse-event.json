                  "description": "A mission id: \"mis_\" followed by a ULID."
                },
                {
                  "type": "null"
                }
              ]
            },
            "from": {
              "type": "string",
              "enum": [
                "PROPOSED",
                "DENIED",
                "AWAITING_APPROVAL",
                "APPROVED",
                "REJECTED",
                "EXPIRED",
                "SUBMITTING",
                "SUBMITTED",
                "FAILED",
                "UNKNOWN",
                "CONFIRMED",
                "INCIDENT"
              ]
            },
            "to": {
              "type": "string",
              "enum": [
                "PROPOSED",
                "DENIED",
                "AWAITING_APPROVAL",
                "APPROVED",
                "REJECTED",
                "EXPIRED",
                "SUBMITTING",
                "SUBMITTED",
                "FAILED",
                "UNKNOWN",
                "CONFIRMED",
                "INCIDENT"
              ]
            }
          },
          "required": [
            "actionId",
            "missionId",
            "from",
            "to"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "orgId",
        "occurredAt",
        "type",
        "data"
      ],
      "additionalProperties": false
    },
