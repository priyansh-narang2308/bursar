{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "decisionId": {
      "type": "string",
      "minLength": 30,
      "maxLength": 30,
      "pattern": "^dec_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "description": "A decision id: \"dec_\" followed by a ULID."
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "\\S"
    }
  },
  "required": [
    "decisionId",
    "reason"
  ],
  "additionalProperties": false
}
