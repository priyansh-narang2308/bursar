{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "missionId": {
      "type": "string",
      "minLength": 30,
      "maxLength": 30,
      "pattern": "^mis_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "description": "The mission this is about."
    },
    "taskId": {
      "type": "string",
      "minLength": 30,
      "maxLength": 30,
      "pattern": "^tsk_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "description": "The plan task to move."
    },
    "newStart": {
      "type": "string",
      "maxLength": 35,
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$",
      "description": "The proposed new start, in UTC."
    },
    "reason": {
      "type": "string",
      "enum": [
        "SUPPLIER_DELAY",
        "DEADLINE_CHANGE",
        "DEPENDENCY_CHANGE",
        "OTHER"
      ]
    }
  },
  "required": [
    "missionId",
    "taskId",
    "newStart",
    "reason"
  ],
  "additionalProperties": false
}
