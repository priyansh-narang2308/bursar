{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 30,
      "maxLength": 30,
      "pattern": "^act_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "description": "A action id: \"act_\" followed by a ULID."
    },
    "orgId": {
      "type": "string",
      "minLength": 30,
      "maxLength": 30,
      "pattern": "^org_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "description": "A organization id: \"org_\" followed by a ULID."
    },
    "missionId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 30,
          "maxLength": 30,
          "pattern": "^mis_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "description": "A mission id: \"mis_\" followed by a ULID."
        },
        {
          "type": "null"
        }
      ]
    },
    "mandateId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 30,
          "maxLength": 30,
          "pattern": "^mnd_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "description": "A mandate id: \"mnd_\" followed by a ULID."
        },
        {
          "type": "null"
        }
      ]
    },
    "type": {
      "type": "string",
      "enum": [
        "AUTHORIZE",
        "CAPTURE",
        "VOID",
        "REFUND",
        "REAUTHORIZE",
        "PAYOUT",
        "FREEZE",
        "REVOKE"
      ]
    },
    "amount": {
      "anyOf": [
        {
          "$ref": "#/$defs/Amount"
        },
        {
          "type": "null"
        }
      ]
    },
    "supplierId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 30,
          "maxLength": 30,
          "pattern": "^sup_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "description": "A supplier id: \"sup_\" followed by a ULID."
        },
        {
          "type": "null"
        }
      ]
    },
    "cartId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 30,
          "maxLength": 30,
          "pattern": "^crt_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "description": "A cart id: \"crt_\" followed by a ULID."
        },
        {
          "type": "null"
        }
      ]
    },
    "cartHash": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "description": "The SHA-256 of the canonical cart: what an approval signs."
        },
        {
          "type": "null"
        }
      ]
    },
    "proposedBy": {
      "type": "string",
      "enum": [
        "USER",
        "AGENT",
        "VERIFIER",
        "SYSTEM"
      ]
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "description": "The idempotency key of an action: a SHA-256, unique per action."
    },
    "state": {
      "type": "string",
      "enum": [
        "PROPOSED",
        "DENIED",
        "AWAITING_APPROVAL",
        "APPROVED",
        "REJECTED",
        "EXPIRED",
        "SUBMITTING",
        "SUBMITTED",
        "FAILED",
        "UNKNOWN",
        "CONFIRMED",
        "INCIDENT"
      ]
    },
    "compensatesActionId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 30,
          "maxLength": 30,
          "pattern": "^act_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "description": "A action id: \"act_\" followed by a ULID."
        },
        {
          "type": "null"
        }
      ]
    },
    "createdAt": {
      "type": "string",
      "maxLength": 35,
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$",
      "description": "An instant in UTC, as RFC 3339 with a trailing Z."
    },
    "updatedAt": {
      "type": "string",
      "maxLength": 35,
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$",
      "description": "An instant in UTC, as RFC 3339 with a trailing Z."
    }
  },
  "required": [
    "id",
    "orgId",
    "missionId",
    "mandateId",
    "type",
    "amount",
    "supplierId",
    "cartId",
    "cartHash",
    "proposedBy",
    "idempotencyKey",
    "state",
    "compensatesActionId",
    "createdAt",
    "updatedAt"
  ],
  "additionalProperties": false,
  "description": "One thing Bursar does with money, and where it is in its life.",
  "$defs": {
    "Amount": {
      "type": "object",
      "properties": {
        "currency": {
          "type": "string",
          "enum": [
            "AUD",
            "BRL",
            "CAD",
            "CHF",
            "CNY",
            "CZK",
            "DKK",
            "EUR",
            "GBP",
            "HKD",
            "HUF",
            "ILS",
            "JPY",
            "MXN",
            "MYR",
            "NOK",
            "NZD",
            "PHP",
            "PLN",
            "RUB",
            "SEK",
            "SGD",
            "THB",
            "TWD",
            "USD"
          ],
          "description": "A currency PayPal accepts."
        },
        "minor": {
          "type": "string",
          "maxLength": 20,
          "pattern": "^(?:0|[1-9][0-9]*)$",
          "description": "Whole minor units (cents for USD) as a string, since JSON numbers cannot hold a bigint."
        }
      },
      "required": [
        "currency",
        "minor"
      ],
      "additionalProperties": false,
      "description": "A non-negative amount of money in whole minor units."
    }
  }
}
