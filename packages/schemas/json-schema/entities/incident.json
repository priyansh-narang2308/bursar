{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 30,
      "maxLength": 30,
      "pattern": "^inc_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "description": "A incident id: \"inc_\" followed by a ULID."
    },
    "orgId": {
      "type": "string",
      "minLength": 30,
      "maxLength": 30,
      "pattern": "^org_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "description": "A organization id: \"org_\" followed by a ULID."
    },
    "type": {
      "type": "string",
      "enum": [
        "UNEXPLAINED_MOVEMENT",
        "AMOUNT_MISMATCH",
        "RECONCILIATION_GAP",
        "WEBHOOK_VERIFICATION_FAILED",
        "DISPUTE_OPENED",
        "UNKNOWN_OUTCOME",
        "HASH_CHAIN_BROKEN"
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "OPEN",
        "CONTAINED",
        "RESOLVED"
      ]
    },
    "openedAt": {
      "type": "string",
      "maxLength": 35,
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$",
      "description": "An instant in UTC, as RFC 3339 with a trailing Z."
    },
    "closedAt": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 35,
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$",
          "description": "An instant in UTC, as RFC 3339 with a trailing Z."
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "maxLength": 100
      },
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "description": "A JSON object."
    },
    "autoResponse": {
      "maxItems": 10,
      "type": "array",
      "items": {
        "$ref": "#/$defs/IncidentResponse"
      }
    },
    "resolution": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "by": {
              "type": "string",
              "minLength": 30,
              "maxLength": 30,
              "pattern": "^usr_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
              "description": "A user id: \"usr_\" followed by a ULID."
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500,
              "pattern": "\\S"
            }
          },
          "required": [
            "by",
            "reason"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "orgId",
    "type",
    "severity",
    "status",
    "openedAt",
    "closedAt",
    "evidence",
    "autoResponse",
    "resolution"
  ],
  "additionalProperties": false,
  "description": "Something that does not add up, and what was done about it.",
  "$defs": {
    "JsonValue": {
      "description": "Any JSON value.",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JsonValue"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "maxLength": 100
          },
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          }
        }
      ]
    },
    "IncidentResponse": {
      "type": "object",
      "properties": {
        "step": {
          "type": "string",
          "enum": [
            "FREEZE_MANDATE",
            "VOID_AUTHORIZATIONS",
            "REFUND_CAPTURE",
            "REVOKE_VAULT_TOKEN",
            "NOTIFY_OWNER"
          ]
        },
        "actionId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 30,
              "maxLength": 30,
              "pattern": "^act_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
              "description": "A action id: \"act_\" followed by a ULID."
            },
            {
              "type": "null"
            }
          ]
        },
        "at": {
          "type": "string",
          "maxLength": 35,
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$",
          "description": "An instant in UTC, as RFC 3339 with a trailing Z."
        }
      },
      "required": [
        "step",
        "actionId",
        "at"
      ],
      "additionalProperties": false,
      "description": "One step the Verifier took in response to an incident."
    }
  }
}
