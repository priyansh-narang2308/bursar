{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 30,
      "maxLength": 30,
      "pattern": "^dec_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "description": "A decision id: \"dec_\" followed by a ULID."
    },
    "actionId": {
      "type": "string",
      "minLength": 30,
      "maxLength": 30,
      "pattern": "^act_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "description": "A action id: \"act_\" followed by a ULID."
    },
    "policyVersionId": {
      "type": "string",
      "minLength": 30,
      "maxLength": 30,
      "pattern": "^plv_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "description": "A policyVersion id: \"plv_\" followed by a ULID."
    },
    "policyHash": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "description": "The SHA-256 of the policy version a decision was made under."
    },
    "phase": {
      "type": "string",
      "enum": [
        "PROPOSE",
        "EXECUTE"
      ]
    },
    "outcome": {
      "type": "string",
      "enum": [
        "ALLOW",
        "REQUIRE_APPROVAL",
        "DENY"
      ]
    },
    "requiredApprovals": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2
    },
    "trace": {
      "minItems": 1,
      "maxItems": 64,
      "type": "array",
      "items": {
        "$ref": "#/$defs/RuleResult"
      }
    },
    "inputsHash": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "description": "The SHA-256 of the inputs a decision was evaluated on."
    },
    "evaluatedAt": {
      "type": "string",
      "maxLength": 35,
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$",
      "description": "An instant in UTC, as RFC 3339 with a trailing Z."
    }
  },
  "required": [
    "id",
    "actionId",
    "policyVersionId",
    "policyHash",
    "phase",
    "outcome",
    "requiredApprovals",
    "trace",
    "inputsHash",
    "evaluatedAt"
  ],
  "additionalProperties": false,
  "description": "The policy engine's ruling on an action, with the rules behind it.",
  "$defs": {
    "RuleResult": {
      "type": "object",
      "properties": {
        "rule": {
          "type": "string",
          "enum": [
            "R-MANDATE",
            "R-ENVELOPE",
            "R-ITEM-CAP",
            "R-ORDER-CAP",
            "R-CATEGORY",
            "R-VENDOR",
            "R-NEW-VENDOR",
            "R-QTY",
            "R-PRICE-DRIFT",
            "R-DUPLICATE",
            "R-VELOCITY",
            "R-DELIVERY",
            "R-DUAL",
            "R-REFUND-AUTH",
            "R-PAYOUT-GATE",
            "R-PROVENANCE",
            "R-TENANT"
          ]
        },
        "outcome": {
          "type": "string",
          "enum": [
            "ALLOW",
            "REQUIRE_APPROVAL",
            "DENY"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "pattern": "\\S"
        },
        "inputs": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "maxLength": 100
          },
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "description": "A JSON object."
        },
        "threshold": {
          "$ref": "#/$defs/JsonValue"
        }
      },
      "required": [
        "rule",
        "outcome",
        "message",
        "inputs",
        "threshold"
      ],
      "additionalProperties": false,
      "description": "What one policy rule concluded, and what it looked at."
    },
    "JsonValue": {
      "description": "Any JSON value.",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JsonValue"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "maxLength": 100
          },
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          }
        }
      ]
    }
  }
}
