  },
  "dependencies": {
    "@bursar/crypto": "workspace:*",
    "@bursar/db": "workspace:*",
    "@bursar/schemas": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@bursar/tooling": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
