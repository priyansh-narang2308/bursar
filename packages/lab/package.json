{
  "name": "@bursar/lab",
  "version": "0.0.0",
  "private": true,
  "description": "The Policy Lab: generates adversarial spending scenarios, runs them against a policy, checks invariants, minimises what breaks, proposes patches and freezes the fix as a regression.",
