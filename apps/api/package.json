{
  "name": "@bursar/api",
  "version": "0.0.0",
  "private": true,
  "description": "Bursar's HTTP API: Hono, tenant-scoped by row-level security, with sessions, roles and agent keys.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "tsx --env-file-if-exists=../../.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@bursar/crypto": "workspace:*",
    "@bursar/db": "workspace:*",
    "@bursar/schemas": "workspace:*",
    "@hono/node-server": "catalog:",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "pino": "catalog:",
    "tsx": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@bursar/tooling": "workspace:*",
    "@electric-sql/pglite": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
