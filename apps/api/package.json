{
  "name": "@bursar/api",
  "version": "0.0.0",
  "private": true,
  "description": "Bursar's HTTP API: Hono, tenant-scoped by row-level security, with sessions, roles and agent keys.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "tsx --env-file-if-exists=../../.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "dev:demo": "tsx src/dev.ts"
  },
  "dependencies": {
    "@bursar/agent-tools": "workspace:*",
    "@bursar/agents": "workspace:*",
    "@bursar/channel3": "workspace:*",
    "@bursar/core": "workspace:*",
    "@bursar/crypto": "workspace:*",
    "@bursar/db": "workspace:*",
    "@bursar/llm": "workspace:*",
    "@bursar/mcp-gateway": "workspace:*",
    "@bursar/money": "workspace:*",
    "@bursar/paypal": "workspace:*",
    "@bursar/paypal-fake": "workspace:*",
    "@bursar/policy": "workspace:*",
    "@bursar/schedule": "workspace:*",
    "@bursar/schemas": "workspace:*",
    "@bursar/workflows": "workspace:*",
    "@electric-sql/pglite": "catalog:",
    "@hono/node-server": "catalog:",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "pino": "catalog:",
    "tsx": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "catalog:",
    "@bursar/tooling": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
