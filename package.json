{
  "name": "bursar",
  "version": "0.0.0",
  "private": true,
  "description": "Spend authority for AI agents: a policy-enforced, PayPal-verified control plane.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": "^24.0.0 || ^26.0.0",
    "pnpm": ">=11"
  },
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r --workspace-concurrency=Infinity typecheck && tsc --noEmit -p tsconfig.json",
    "test": "pnpm -r test",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @bursar/db migrate",
    "db:reset": "docker compose down -v && pnpm db:up && pnpm db:migrate",
    "dev:doctor": "tsx scripts/dev/verify-tooling.ts",
    "dev:skills": "tsx scripts/dev/install-skills.ts",
    "prepare": "lefthook install || echo 'lefthook unavailable: skipping git hooks'",
    "dev:demo": "pnpm --filter @bursar/api dev:demo",
    "dev:web": "pnpm --filter @bursar/web dev",
    "dev:payer": "pnpm --filter @bursar/api payer",
    "dev:spike": "pnpm --filter @bursar/api spike",
    "start:demo": "node --import tsx apps/api/src/dev.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@bursar/tooling": "workspace:*",
    "@types/node": "catalog:",
    "lefthook": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
