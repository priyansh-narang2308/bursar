# ---------- App ----------
NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:8787
DATABASE_URL=postgres://bursar:bursar@localhost:5432/bursar
ALLOW_LIVE=false

# ---------- App-internal secrets (dev values; generate fresh ones for Render) ----------
# openssl rand -hex 32   (a separate one for each: never reuse a key for two purposes)
PROVENANCE_HMAC_KEY=
APPROVAL_HMAC_KEY=
# One key, or `version:key` entries separated by commas to rotate: the highest version seals
VAULT_ENC_KEY=
SESSION_SECRET=

# ---------- PayPal (SANDBOX) ----------
PAYPAL_ENV=sandbox
# Sandbox REST app "Bursar Executor" (features: Accept payments, Save payment methods/Vault,
# Payouts, Transaction search, Webhooks).  developer.paypal.com > Apps & Credentials > Sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Filled after the webhook is registered (scripts/register-webhook)
PAYPAL_WEBHOOK_ID=
# OPTIONAL: a second read-only sandbox app, only used to verify webhook signatures
PAYPAL_READER_CLIENT_ID=
PAYPAL_READER_CLIENT_SECRET=

# Sandbox accounts (all US).  developer.paypal.com > Testing tools > Sandbox accounts
PAYPAL_PLATFORM_EMAIL=
PAYPAL_PAYER_1_EMAIL=
PAYPAL_PAYER_2_EMAIL=
PAYPAL_PAYER_3_EMAIL=
PAYPAL_SUPPLIER_1_EMAIL=
PAYPAL_SUPPLIER_2_EMAIL=
# OPTIONAL — only for the Playwright "approver" script that YOU run on your own machine
# (it logs in as a sandbox buyer to approve vault/one-time popups). Sandbox test accounts only.
PAYPAL_PAYER_1_PASSWORD=
PAYPAL_PAYER_2_PASSWORD=
PAYPAL_PAYER_3_PASSWORD=
# NOTE: the PayPal AI Toolkit's dev-time MCP token (PAYPAL_SANDBOX_ACCESS_TOKEN, expires <= 8 h)
# belongs in ~/.claude/settings.json under "env", NOT in this file.

# ---------- Channel3 ----------
# trychannel3.com/developers  (promo code PAYPAL-HACKATHON-2026 => 20,000 credits)
CHANNEL3_API_KEY=

# ---------- AG Grid / AG Studio (the licence is visible in the browser by nature) ----------
VITE_AG_STUDIO_LICENSE_KEY=
# Only if you use AG Grid Enterprise features outside Studio:
VITE_AG_GRID_LICENSE_KEY=

# ---------- Bryntum ----------
# Trial packages (npm alias @bryntum/*-trial) need NO key. Leave empty unless you get a licensed token.
BRYNTUM_NPM_TOKEN=

# ---------- Render ----------
# dashboard.render.com > Account settings > API keys
RENDER_API_KEY=
RENDER_WORKFLOW_SLUG=bursar
# Local `render workflows dev "<start cmd>"` task server
RENDER_TASKS_URL=http://localhost:8120

# ---------- AI ----------
ANTHROPIC_API_KEY=
AI_MODEL_PRIMARY=claude-sonnet-5-5
AI_MODEL_FAST=claude-haiku-4-5-20251001

# ---------- Dev-time tooling that needs NO app key ----------
# APIMatic Context Plugin:  npx context-plugins install paypal      (no credentials)
# PayPal AI Toolkit:        /plugin install paypal@claude-plugins-official
# AG Studio skills:         npx skills add ag-grid/skills
# Not used: Elastic, Zapier, Postman, KERNEL, Astropods.
